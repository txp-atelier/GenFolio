APP_NAME=GenFolio API
ENVIRONMENT=development

# When running via docker-compose, host is the service name "db".
# When running the backend locally against the dockerized db, use localhost.
DATABASE_URL=postgresql+asyncpg://genfolio:genfolio@localhost:5432/genfolio

JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Leave unset to fall back automatically: localhost in development,
# https://genfolio-txp.vercel.app when ENVIRONMENT=production. Set explicitly
# only to override.
# CORS_ORIGINS=["http://localhost:3000"]

# FRONTEND_URL=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Free token from https://huggingface.co/settings/tokens — used for the RAG
# chatbot's retrieval embeddings (Hugging Face's hosted Inference API, so no
# ML runtime has to load in this process — see app.core.vector_store).
HUGGINGFACE_API_TOKEN=
